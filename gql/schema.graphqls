type QuoteBlock implements IData & _IComponent & _IContent & _IItem {
  QuoteActive: Boolean
  QuoteColor: String
  QuoteProfileLocation: String
  QuoteProfileName: String
  QuoteProfilePicture: ContentReference
  QuoteText: String
  Test: [String]
  _children: QueryRef @deprecated(reason: "Use `_link` field instead")
  _deleted: Bool
  _fulltext(highlight: HighlightOptions): [String]
  _id: String
  _itemMetadata: _Metadata
  _json: JSON
  _link(type: LinkTypes): QueryRef
  _metadata: IContentMetadata
  _modified: Date
  _score: Float
  _track: String
}

type QuoteBlockAutocomplete {
  QuoteColor(limit: Int! = 10, value: String!): [String]
  QuoteProfileName(limit: Int! = 10, value: String!): [String]
  QuoteProfilePicture: ContentReferenceAutocomplete
  _itemMetadata: _MetadataAutocomplete
  _metadata: IContentMetadataAutocomplete
}

type QuoteBlockFacet {
  QuoteActive(filters: [String!], limit: Int! = 10, orderBy: OrderBy = DESC, orderType: OrderByFacetType = COUNT): [StringFacet]
  QuoteColor(filters: [String!], limit: Int! = 10, orderBy: OrderBy = DESC, orderType: OrderByFacetType = COUNT): [StringFacet]
  QuoteProfileName(filters: [String!], limit: Int! = 10, orderBy: OrderBy = DESC, orderType: OrderByFacetType = COUNT): [StringFacet]
  QuoteProfilePicture: ContentReferenceFacet
  _itemMetadata: _MetadataFacet
  _metadata: IContentMetadataFacet
}

input QuoteBlockOrderByInput {
  QuoteActive: OrderBy
  QuoteColor: OrderBy
  QuoteProfileName: OrderBy
  QuoteProfilePicture: ContentReferenceOrderByInput
  _itemMetadata: _MetadataOrderByInput
  _metadata: IContentMetadataOrderByInput
  _minimumScore: Float
  _modified: OrderBy
  _ranking: Ranking
  """
  The value needs to be a positive value, but cannot exceed the maximum value of an integer. In case it is exceeded, the maximum of an integer is used. In case of a negative value, semantic search will be disabled.
  """
  _semanticWeight: Float
}

type QuoteBlockOutput {
  autocomplete: QuoteBlockAutocomplete
  cursor: String
  facets: QuoteBlockFacet
  item: QuoteBlock
  items: [QuoteBlock]
  total(all: Boolean): Int
}

input QuoteBlockWhereInput {
  QuoteActive: BoolFilterInput
  QuoteColor: StringFilterInput
  QuoteProfileName: StringFilterInput
  QuoteProfilePicture: ContentReferenceWhereInput
  _and: [QuoteBlockWhereInput]
  _fulltext: SearchableStringFilterInput
  _itemMetadata: _MetadataWhereInput
  _metadata: IContentMetadataWhereInput
  _modified: DateFilterInput
  _not: [QuoteBlockWhereInput]
  _or: [QuoteBlockWhereInput]
}

input RangeFacetsInput {
  from: Int
  to: Int
}

enum Ranking {
  BOOST_ONLY
  DOC
  RELEVANCE
  SEMANTIC
}

